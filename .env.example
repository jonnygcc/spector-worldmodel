# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git; never commit real keys.

# Required. Gemini API key (Google AI Studio). Used by the Agent and the World Model.
GEMINI_API_KEY=your-gemini-api-key

# Optional. OpenRouter as a second provider for the World Model.
# Both are needed for it to be used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional. World Model provider order: "openrouter" tries OpenRouter first.
# Any other value, or empty, tries Gemini first.
WORLD_MODEL_PROVIDER=

# Optional. World Model time limit in milliseconds. Default 25000.
WORLD_MODEL_TIMEOUT_MS=

# Optional. Chromium executable for the browser agent. Default: the one
# playwright-core installs for its version (npx playwright-core install chromium).
SPECTOR_CHROMIUM_PATH=
